{
  "name": "react_sample_app",
  "version": "1.0.0",
  "description": "A sample React application",
  "author": "Zach Schneider <me@zachschneider.com>",
  "repository": {
    "type": "git",
    "url": "TBD"
  },
  "scripts": {
    "browserify": "browserify src/react_sample.js | uglifyjs > public/js/react_sample.js",
    "build": "mkdir -p public/js && yarn browserify",
    "ship": "NODE_ENV=production yarn build",
    "test": "jest",
    "test-watch": "jest --watch",
    "server": "yarn build && node server.js"
  },
  "resolutions": {
    "tmp": ">=0.2.4"
  },
  "dependencies": {
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "browserify": "^17.0.1",
    "express": "^5.2.1",
    "jasmine": "^5.9.0",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "node-lessify": "^0.2.0",
    "reactify": "^1.1.1",
    "testem": "^3.16.0",
    "uglify-js": "^3.19.3"
  },
  "browserify": {
    "transform": [
      "reactify",
      "node-lessify"
    ]
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.js"
    ]
  }
}
